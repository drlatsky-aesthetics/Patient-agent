# ── Phorest ──────────────────────────────────────────────────────────────────
# API credentials from Phorest dashboard → Settings → API & Integrations
# NEVER put these in the frontend — they belong in your backend environment only
PHOREST_CLIENT_ID=
PHOREST_CLIENT_SECRET=
PHOREST_BRANCH_ID=

# ── Frontend (safe to expose — Vite bundles VITE_* vars into the client) ──────
VITE_API_BASE_URL=http://localhost:3001   # your Express/Next.js backend
VITE_PHOREST_BOOKING_URL=https://www.phorest.com/salon/treasuryaesthetics

# ── Other services (backend only) ─────────────────────────────────────────────
DATABASE_URL=
CLERK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
ONESIGNAL_API_KEY=

# ── Other services (frontend) ─────────────────────────────────────────────────
VITE_CLERK_PUBLISHABLE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

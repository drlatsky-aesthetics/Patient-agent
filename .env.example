# ── Phorest (BACKEND ONLY — never prefix with VITE_) ─────────────────────────
PHOREST_USERNAME=global/aesthetics@treasuryhealth.ca
PHOREST_PASSWORD=                          # from Phorest API access email
PHOREST_BUSINESS_ID=                       # e.g. CPCJEF0k5-6Qf8gqAtuNPQ
PHOREST_BASE_URL=https://platform.phorest.com/third-party-api-server

# ── Frontend (bundled by Vite — safe, no secrets) ────────────────────────────
VITE_API_BASE_URL=http://localhost:3001
VITE_PHOREST_BOOKING_URL=https://www.phorest.com/salon/treasuryaesthetics

# ── Deployment ────────────────────────────────────────────────────────────────
# Set in Railway → your Vercel frontend domain (e.g. https://treasury.vercel.app)
FRONTEND_URL=
# Set in Vercel → your Railway backend domain (e.g. https://treasury-api.up.railway.app)
VITE_API_BASE_URL=http://localhost:3001

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=

# ── Auth ─────────────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# ── Payments ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Notifications ─────────────────────────────────────────────────────────────
ONESIGNAL_API_KEY=
